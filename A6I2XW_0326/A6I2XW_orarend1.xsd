<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

    <xs:element name="A6I2XW_orarend" type="orarendTipus"/>

    <xs:complexType name="orarendTipus">
        <xs:sequence>
            <xs:element name="ora" type="oraTipus" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="oraTipus">
        <xs:sequence>
            <xs:element name="kurzus" type="szovegTipus"/>
            <xs:element name="idopont" type="idopontTipus"/>
            <xs:element name="helyszin" type="szovegTipus"/>
            <xs:element name="oktato" type="szovegTipus"/>
            <xs:element name="szak" type="szovegTipus"/>
        </xs:sequence>
        <xs:attribute name="id" type="oraAzonositoTipus" use="required"/>
        <xs:attribute name="tipus" type="oraJellegTipus" use="required"/>
    </xs:complexType>

    <xs:complexType name="idopontTipus">
        <xs:sequence>
            <xs:element name="nap" type="napTipus"/>
            <xs:element name="tol" type="idoTipus"/>
            <xs:element name="ig" type="idoTipus"/>
        </xs:sequence>
    </xs:complexType>

    <xs:simpleType name="szovegTipus">
        <xs:restriction base="xs:string">
            <xs:minLength value="1"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="oraAzonositoTipus">
        <xs:restriction base="xs:ID">
            <xs:pattern value="ora[0-9]{2}"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="oraJellegTipus">
        <xs:restriction base="xs:string">
            <xs:enumeration value="elmélet"/>
            <xs:enumeration value="gyakorlat"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="napTipus">
        <xs:restriction base="xs:string">
            <xs:pattern value="(0[1-9]|1[0-2])\.([0-2][0-9]|3[0-1])\."/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="idoTipus">
        <xs:restriction base="xs:string">
            <xs:pattern value="([01][0-9]|2[0-3]):[0-5][0-9]"/>
        </xs:restriction>
    </xs:simpleType>

</xs:schema>
